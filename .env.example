# REVIVE Environment Configuration

APP_ENV=development
PORT=8000
HOST=0.0.0.0

# Integration Mode: 'simulation' or 'real_test'
# In simulation mode, Razorpay and external services are simulated deterministically.
# In real_test mode, official Razorpay Test Mode credentials are used.
INTEGRATION_MODE=simulation

# Database Connection
# SQLite for zero-friction local run:
DATABASE_URL=sqlite+aiosqlite:///./revive.db
# PostgreSQL for production/docker:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/revive

# AI Provider Configuration
# Supported providers: 'deterministic_fallback', 'openai', 'gemini'
AI_PROVIDER=deterministic_fallback
OPENAI_API_KEY=
GEMINI_API_KEY=

# Razorpay Test Mode Credentials (Backend Only - NEVER exposed to frontend)
RAZORPAY_KEY_ID=rzp_test_revive_demo
RAZORPAY_KEY_SECRET=revive_secret_key_12345
RAZORPAY_WEBHOOK_SECRET=revive_webhook_secret_67890

# Security & CORS
SECRET_KEY=revive-super-secret-production-key-change-in-prod
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
